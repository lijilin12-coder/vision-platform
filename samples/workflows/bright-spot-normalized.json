{
  "id": "bright-spot-normalized",
  "version": 1,
  "name": "亮斑检测（先做亮度归一化）",
  "description": "在较暗的表面上找出亮的斑点，并且不受光源整体变亮、变暗的影响：转灰度 → 亮度归一化（把画面的中位灰度调到固定值）→ 固定阈值 → 连通域 → 数量判定。一个亮斑都不允许。",
  "nodes": [
    {
      "key": "input",
      "operator": "vision.image_input"
    },
    {
      "key": "gray",
      "operator": "vision.to_gray"
    },
    {
      "key": "norm",
      "operator": "vision.normalize_brightness",
      "params": {
        "target": 128
      }
    },
    {
      "key": "bin",
      "operator": "vision.threshold",
      "params": {
        "method": "fixed",
        "invert": false
      }
    },
    {
      "key": "blobs",
      "operator": "vision.blob"
    },
    {
      "key": "judge",
      "operator": "vision.judge_count",
      "params": {
        "maxCount": 0,
        "label": "亮斑"
      }
    }
  ],
  "edges": [
    [
      "input.image",
      "gray.image"
    ],
    [
      "gray.image",
      "norm.image"
    ],
    [
      "norm.image",
      "bin.image"
    ],
    [
      "bin.region",
      "blobs.region"
    ],
    [
      "blobs.blobs",
      "judge.blobs"
    ]
  ],
  "tunables": [
    {
      "node": "bin",
      "param": "value",
      "min": 0,
      "max": 255,
      "initial": 100,
      "hint": "灰度阈值，针对归一化之后的图像（画面的中位灰度是 128）。比它亮的像素算作亮斑。"
    },
    {
      "node": "blobs",
      "param": "minArea",
      "min": 1,
      "max": 2000,
      "initial": 1,
      "hint": "最小面积（像素）。比它小的连通域不算亮斑，用来去掉灰尘和噪点。太大会漏掉小的缺陷。"
    }
  ],
  "robustness": [
    {
      "kind": "brightness",
      "levels": [
        0.7,
        0.8,
        0.9,
        1.1,
        1.2
      ]
    },
    {
      "kind": "noise",
      "levels": [
        5,
        10,
        15
      ]
    }
  ]
}
